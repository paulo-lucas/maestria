{
  "name": "maestria",
  "version": "0.1.0",
  "description": "Self-hosted control panel and protocol for Maestri workspaces",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "maestri",
    "ai-agents",
    "control-panel"
  ],
  "engines": {
    "node": ">=24.7"
  },
  "bin": {
    "maestria": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --experimental-transform-types --watch src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@inquirer/prompts": "8.8.0",
    "better-sqlite3": "13.1.1",
    "fastify": "5.12.8",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
